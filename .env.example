# =============================================================================
# Supabase
# Settings → API no painel do projeto Supabase.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
# Secreta — nunca expor ao browser. Usada só em API routes / server actions.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# =============================================================================
# Meta / Instagram (developers.facebook.com/apps/<app-id>)
# =============================================================================
# "ID do app do Instagram" e "Chave secreta do app do Instagram" (dentro do
# caso de uso "Gerenciar mensagens e conteúdo no Instagram").
META_APP_ID=
META_APP_SECRET=
# Mesma string de 48+ caracteres cadastrada em "Verificar token" do webhook.
META_WEBHOOK_VERIFY_TOKEN=
# Usado para criptografar o access_token do Instagram antes de salvar no banco
# e para assinar o `state` do fluxo OAuth (propositalmente separado do
# META_APP_SECRET, que é o segredo da própria Meta). Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# URL pública da aplicação (sem barra no final). Usada para montar as URLs de
# redirect do OAuth e do webhook. Em produção: https://seuprojeto.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OpenAI
# =============================================================================
OPENAI_API_KEY=sk-xxxxx...

# =============================================================================
# Cron (endpoint interno que processa delays/agendamentos das automações)
# Gere uma string aleatória e cadastre em vercel.json / Vercel Cron Jobs como
# header de autorização.
# =============================================================================
CRON_SECRET=

# =============================================================================
# Stripe (estrutura pronta — preencher quando for ativar cobrança)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
